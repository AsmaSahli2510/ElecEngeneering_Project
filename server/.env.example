PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/elec-project

# Durées de garantie (en mois) appliquées à la création d'un actif ; modifiables ensuite sur chaque actif.
WARRANTY_PARTS_MONTHS=24
WARRANTY_LABOR_MONTHS=12

# Secret de signature des jetons d'authentification (JWT) — à générer par environnement, jamais partagé/commité en clair.
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
